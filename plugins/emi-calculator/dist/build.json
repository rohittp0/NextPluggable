{
  "buildVersion": 1,
  "manifest": {
    "manifestVersion": 1,
    "id": "emi-calculator",
    "name": "EMI Calculator",
    "version": "1.1.0",
    "description": "A loan EMI calculator page with a yearly repayment schedule. Visitors adjust amount, interest rate and tenure and see their monthly instalment instantly.",
    "author": "NextPluggable",
    "icon": "🧮",
    "category": "Tools",
    "pages": [
      {
        "id": "calculator",
        "path": "/emi-calculator",
        "component": "CalculatorPage",
        "title": "EMI Calculator",
        "description": "The calculator page your visitors use."
      }
    ],
    "settings": [
      {
        "key": "heading",
        "label": "Page heading",
        "type": "text",
        "default": "EMI Calculator",
        "required": true,
        "group": "Content"
      },
      {
        "key": "intro",
        "label": "Introduction",
        "type": "textarea",
        "default": "Work out your monthly instalment in seconds. Adjust the loan amount, interest rate and tenure to see how they change what you pay.",
        "help": "A short paragraph shown under the heading. It also becomes the page description on Google.",
        "group": "Content"
      },
      {
        "key": "ctaLabel",
        "label": "Button text",
        "type": "text",
        "placeholder": "Apply now",
        "help": "Optional. Shows a button under the result.",
        "group": "Content"
      },
      {
        "key": "ctaUrl",
        "label": "Button link",
        "type": "url",
        "placeholder": "https://example.com/apply",
        "group": "Content"
      },
      {
        "key": "currency",
        "label": "Currency symbol",
        "type": "text",
        "default": "₹",
        "required": true,
        "group": "Numbers"
      },
      {
        "key": "grouping",
        "label": "Number format",
        "type": "select",
        "default": "indian",
        "options": [
          {
            "value": "indian",
            "label": "Indian (12,34,567)"
          },
          {
            "value": "international",
            "label": "International (1,234,567)"
          }
        ],
        "group": "Numbers"
      },
      {
        "key": "defaultAmount",
        "label": "Starting loan amount",
        "type": "number",
        "default": 2500000,
        "min": 1000,
        "group": "Numbers"
      },
      {
        "key": "maxAmount",
        "label": "Largest loan amount",
        "type": "number",
        "default": 20000000,
        "min": 10000,
        "group": "Numbers"
      },
      {
        "key": "defaultRate",
        "label": "Starting interest rate (% per year)",
        "type": "number",
        "default": 8.5,
        "min": 0,
        "max": 40,
        "step": 0.05,
        "group": "Numbers"
      },
      {
        "key": "defaultYears",
        "label": "Starting tenure (years)",
        "type": "number",
        "default": 20,
        "min": 1,
        "max": 40,
        "group": "Numbers"
      },
      {
        "key": "showSchedule",
        "label": "Show yearly repayment schedule",
        "type": "toggle",
        "default": true,
        "group": "Appearance"
      },
      {
        "key": "accent",
        "label": "Accent colour",
        "type": "color",
        "placeholder": "Your site's colour",
        "help": "Leave empty to use your site's own colour.",
        "group": "Appearance"
      }
    ]
  },
  "icon": "🧮",
  "files": {
    "client": {
      "path": "dist/client.js",
      "sha256": "14d8ac854659efe82aa6d0265bc3c6ca19eee3986a3285d82cd508706a448235",
      "bytes": 5109
    },
    "style": {
      "path": "dist/style.css",
      "sha256": "105caebdd1563ca9e622dcdafc291b20eaeaeff7d61cdc016dbb1f13c9875db5",
      "bytes": 4531
    },
    "server": {
      "path": "dist/server.js",
      "sha256": "3e23c8159f05d7530ca71e3d6c40c56f1d124be607eb4f0eeb85a36c405e97f7",
      "bytes": 1476
    }
  }
}
