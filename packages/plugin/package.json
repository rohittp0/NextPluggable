{
  "name": "@nextpluggable/plugin",
  "version": "0.1.0",
  "description": "SDK and build tool for writing NextPluggable plugins",
  "license": "MIT",
  "type": "module",
  "bin": { "nextpluggable-plugin": "./bin/nextpluggable-plugin.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "default": "./dist/manifest.js" },
    "./build": { "types": "./dist/build.d.ts", "default": "./dist/build.js" }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "esbuild": ">=0.21", "react": ">=18" },
  "peerDependenciesMeta": { "esbuild": { "optional": true }, "react": { "optional": true } },
  "devDependencies": { "@types/react": "^19.2.0", "esbuild": "^0.28.2", "react": "^19.2.0" }
}
